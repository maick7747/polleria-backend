# Servidor
PORT=3000
NODE_ENV=development

# Persistencia: memory (store.js) | supabase (repository.js)
DB_MODE=memory

# Conexión directa a PostgreSQL/Supabase SOLO para aplicar migraciones (npm run db:apply).
# Formato: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Obtener en Supabase → Settings → Database → Connection string. No se usa en runtime.
DATABASE_URL=

# Supabase (opcional: sin estas variables la API usa el store en memoria)
SUPABASE_URL=
SUPABASE_KEY=
# Solo backend. Bypassa RLS; nunca exponerla al frontend ni al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Autenticación
# OBLIGATORIO en producción (Node con NODE_ENV=production o Render, que define RENDER=1).
# Sin JWT_SECRET la API se niega a arrancar para no firmar tokens con el secreto
# de demo publicado en el repositorio. En desarrollo local se usa ese fallback.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-bytes
TOKEN_TTL_SEC=1800

# CORS y logs
# En producción definir el origen exacto del frontend (separado por comas si hay varios).
# Si falta, la API avisa por consola y deja CORS abierto (*).
CORS_ORIGIN=*
LOG_REQUESTS=1
# Umbral (ms) para el aviso [slow] de /api/metrics. 3000 por defecto.
SLOW_REQUEST_MS=3000

# ---------------------------------------------------------------------------
# Integración — validación de DNI/RUC (patrón Strategy)
# Ver docs/INTEGRACIONES.md
# ---------------------------------------------------------------------------
# Proveedor principal: mock | apiperu | openruc
DOCUMENTO_PROVIDER=mock
# Si el principal falla (red, cuota, credencial), se intenta este. none = sin fallback
DOCUMENTO_FALLBACK=mock
DOCUMENTO_TIMEOUT_MS=5000
# Caché por documento en segundos (0 desactiva)
DOCUMENTO_CACHE_TTL_SEC=86400

# ApiPeruDev (https://docs.apiperu.dev) — plan gratuito con cuota mensual
APIPERU_BASE_URL=https://api.apiperu.dev
APIPERU_TOKEN=

# OpenRUC (https://openruc.com) — API abierta, sin token, solo RUC
OPENRUC_BASE_URL=https://openruc.com

# ---------------------------------------------------------------------------
# Integración — emisión de comprobantes SUNAT (patrón Strategy)
# Ver docs/INTEGRACIONES.md
# ---------------------------------------------------------------------------
# simulado | beta | produccion
SUNAT_MODE=simulado
# Datos del emisor (obligatorios para beta y produccion)
SUNAT_RUC=
SUNAT_RAZON_SOCIAL=FRATELLI'S RESTAURANTE
# Credenciales SOL. En beta, si se omiten se usan las públicas: [RUC]MODDATOS / MODDATOS
SUNAT_USUARIO_SOL=
SUNAT_CLAVE_SOL=
# Solo produccion: ruta al certificado digital (.p12) — aún no se usa para firmar
SUNAT_CERTIFICADO_RUTA=
# Overrides de endpoint (opcional). Si se define SUNAT_API_URL, gana sobre el modo.
SUNAT_API_URL=
SUNAT_BETA_URL=
SUNAT_PRODUCCION_URL=
SUNAT_TIMEOUT_MS=15000
