# Servidor
PORT=3000
NODE_ENV=development

# Persistencia: memory (store.js) | supabase (repository.js)
DB_MODE=memory

# Conexión directa a PostgreSQL/Supabase SOLO para aplicar migraciones (npm run db:apply).
# Formato: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Obtener en Supabase → Settings → Database → Connection string. No se usa en runtime.
DATABASE_URL=

# Supabase (opcional: sin estas variables la API usa el store en memoria)
SUPABASE_URL=
SUPABASE_KEY=
# Solo backend. Bypassa RLS; nunca exponerla al frontend ni al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Autenticación
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-bytes
TOKEN_TTL_SEC=1800

# CORS y logs
CORS_ORIGIN=*
LOG_REQUESTS=1
